   "source": [
    "total = 0      \n",
    "count = 0      \n",
    "\n",
    "while True:\n",
    "    score = int(input(\"点数を入力してください：\"))\n",
    "\n",
    "    if score == -1:\n",
    "        break\n",
    "\n",
    "    total += score\n",
    "    count += 1\n",
    "\n",
    "if count > 0:\n",
    "    average = total / count\n",
    "    print(f\"{count}人のテストの平均点は{average:.1f}点です\")\n",
    "else:\n",
    "    print(\"データが入力されませんでした\")"
   ]
  }
 ],
