   "source": [
    "#@title 九九のリストを作成する\n",
    "kuku = [[v * h for h in range(1, 10)] for v in range(1, 10)]\n",
    "\n",
    "#@title 九九の表を表示する\n",
    "for v in range(1, 10):\n",
    "    for h in range(1, 10):\n",
    "        print(f\"{v * h:3d}\", end=\" \")\n",
    "    print()"
   ]
